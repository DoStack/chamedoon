---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { VIDEOS, abs } from '../../../lib/site';
import { webPage } from '../../../lib/seo';
import { num } from '../../../lib/format';
const path = '/fa/videos/';
const title = 'ویدیوهای راهنمای چمدون';
const description = 'ویدیوهای کوتاه راهنمای چمدونِ خانه: پیدا کردن خانه با فیلتر و گوش‌به‌زنگ، و گذاشتن آگهی خانه در چمدون. با زیرنویس فارسی و متن کامل.';
const list = { '@type': 'ItemList', itemListElement: VIDEOS.map((v, i) => ({ '@type': 'ListItem', position: i + 1, url: abs(`/fa/videos/${v.slug}/`), name: v.title_fa })) };
---
<Base lang="fa" title={title} description={description} path={path} crumbs={[{ name: 'چمدون', path: '/fa/' }, { name: 'ویدیوها', path }]} jsonld={[webPage(path, title, description, 'fa'), list]}>
  <section class="wrap page-hero">
    <h1>ویدیوهای راهنما</h1>
    <ul class="vids">
      {VIDEOS.map((v) => (
        <li>
          <a class="card-link card" href={`/fa/videos/${v.slug}/`}>
            <div class="thumb"><img src={v.poster} width="540" height="960" alt={v.title_fa} loading="lazy" decoding="async" /><span class="play"><Icon name="play" size={28} /></span></div>
            <h2>{v.title_fa}</h2>
            <p class="small muted">{num(v.duration)} ثانیه</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
<style>
  .vids { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); }
  .thumb { position: relative; aspect-ratio: 9 / 16; border-radius: 18px; overflow: hidden; background: var(--navy); margin-block-end: 14px; }
  .thumb img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
  .play { position: absolute; inset: 0; margin: auto; inline-size: 64px; block-size: 64px; border-radius: 50%; background: rgb(255 255 255 / 92%); color: var(--orange); display: grid; place-items: center; }
  h2 { font-size: 1.15rem; margin: 0 0 4px; line-height: 1.6; }
</style>
