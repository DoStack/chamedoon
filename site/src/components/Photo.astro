---
// A page photo from the library (src/data/site-photos.json, files under /media/site/v/photos/). Responsive AVIF/WebP,
// lazy by default; a credit line only where the licence requires one (CC BY); all credits are on /fa/credits/.
import photos from '../data/site-photos.json';
interface Props { k: string; sizes?: string; eager?: boolean; class?: string; ratio?: string; alt?: string; inLink?: boolean }
const { k, sizes = '(max-width: 760px) 100vw, 560px', eager = false, class: cls = '', ratio, alt, inLink = false } = Astro.props;
const p = (photos as any[]).find((x) => x.key === k);
const credit = p?.credit ? String(p.credit).replace(' (wikimedia)', '') : '';
const u = (f: string) => `/media/site/v/photos/${f}`;
const v = p?.variants || {};
const avif = p ? [`${u(`${k}-480.avif`)} 480w`, v['800.avif'] && `${u(v['800.avif'])} 800w`, v['1600.avif'] && `${u(v['1600.avif'])} 1600w`].filter(Boolean).join(', ') : '';
const webp = p ? [v['800.webp'] && `${u(v['800.webp'])} 800w`, v['1600.webp'] && `${u(v['1600.webp'])} 1600w`].filter(Boolean).join(', ') : '';
---
{p && (
  <figure class:list={['photo', cls]} style={ratio ? `--r:${ratio}` : undefined}>
    <picture>
      <source type="image/avif" srcset={avif} sizes={sizes} />
      <img src={u(v['800.webp'] || p.file)} srcset={webp} sizes={sizes} width={p.width} height={p.height} alt={alt ?? p.alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
    </picture>
    {p.byRequired && p.credit && (
      <figcaption>{inLink ? <span>{credit}</span> : <a href="/fa/credits/" rel="nofollow">{credit}</a>}</figcaption>
    )}
  </figure>
)}
<style>
  .photo { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius); background: var(--accent); aspect-ratio: var(--r, 3 / 2); }
  .photo picture, .photo img { display: block; inline-size: 100%; block-size: 100%; }
  .photo img { object-fit: cover; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
  .photo figcaption { position: absolute; inset-block-end: 6px; inset-inline-start: 8px; font-size: 0.68rem; line-height: 1.3; }
  .photo figcaption a, .photo figcaption span { color: #fff; background: rgb(0 0 0 / 45%); padding: 1px 6px; border-radius: 6px; text-decoration: none; direction: ltr; unicode-bidi: isolate; }
</style>
