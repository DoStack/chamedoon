---
// Renders a chart spec from the post's frontmatter (content contract PLAN §4).
// bar → horizontal bars; line → line; donut → donut; timeline → dated list; anything else → table.
import BarChart from '../charts/BarChart.astro';
import { line, curveMonotoneX } from 'd3-shape';
import { scaleLinear, scalePoint } from 'd3-scale';
import { dateFa, dateParts } from '../../lib/format';
interface Props { id: string; charts?: any[] }
const { id, charts = [] } = Astro.props;
const spec = charts.find((c) => c.id === id);
const nf = new Intl.NumberFormat('fa-IR', { maximumFractionDigits: 2 });
const UNIT: Record<string, string> = { listings: 'آگهی', 'CAD/month': 'دلار کانادا', 'EUR/month': 'یورو', CAD: 'دلار کانادا', EUR: 'یورو', '%': '٪', 'EUR/m²': 'یورو بر متر مربع' };
const unit = spec?.unit ? UNIT[spec.unit] ?? spec.unit : '';
const fmt = (v: number) => (unit === '٪' ? `${nf.format(v)}٪` : unit ? `${nf.format(v)} ${unit}` : nf.format(v));
const rows: any[] = Array.isArray(spec?.data) ? spec.data : [];
const type = spec?.type || 'bar';
const titleId = `${id}-t`;
// Line chart geometry
const W = 640, H = 260, pad = 36;
let linePath = '', pts: { x: number; y: number; v: number; l: string }[] = [];
if (type === 'line' && rows.length > 1) {
  const x = scalePoint<string>().domain(rows.map((r) => String(r.label)).reverse()).range([pad, W - pad]);
  const vals = rows.map((r) => Number(r.value));
  const y = scaleLinear().domain([Math.min(0, ...vals), Math.max(...vals) * 1.15 || 1]).range([H - pad, 24]);
  pts = rows.map((r) => ({ x: x(String(r.label))!, y: y(Number(r.value)), v: Number(r.value), l: String(r.label) }));
  linePath = line<{ x: number; y: number }>().x((p) => p.x).y((p) => p.y).curve(curveMonotoneX)(pts) || '';
}
// Donut geometry
const palette = ['var(--orange)', 'var(--navy)', '#E9A27E', '#8FA3B8', '#F3CDB6', '#C9D3DE'];
const total = rows.reduce((s, r) => s + (Number(r.value) || 0), 0) || 1;
let acc = 0;
const arcs = type === 'donut' ? rows.map((r, i) => {
  const a0 = (acc / total) * Math.PI * 2; acc += Number(r.value) || 0; const a1 = (acc / total) * Math.PI * 2;
  const R = 90, r0 = 54, cx = 110, cy = 110;
  const p = (a: number, rad: number) => [cx + rad * Math.sin(a), cy - rad * Math.cos(a)];
  const large = a1 - a0 > Math.PI ? 1 : 0;
  const [x0, y0] = p(a0, R), [x1, y1] = p(a1, R), [x2, y2] = p(a1, r0), [x3, y3] = p(a0, r0);
  return { d: `M${x0},${y0} A${R},${R} 0 ${large} 1 ${x1},${y1} L${x2},${y2} A${r0},${r0} 0 ${large} 0 ${x3},${y3} Z`, c: palette[i % palette.length], r };
}) : [];
---
{!spec ? null : type === 'bar' || type === 'stackedBar' ? (
  <div class="post-chart"><BarChart id={id} title={spec.title} rows={rows.map((r) => ({ label: String(r.label), value: r.value == null ? null : Number(r.value) }))} format={fmt} headers={['', 'مقدار']} source={spec.source ? `منبع: ${spec.source}` : undefined} /></div>
) : (
  <figure class="chart post-chart" id={id}>
    <figcaption id={titleId}>{spec.title}</figcaption>
    {type === 'line' && pts.length > 1 && (
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={titleId}>
        <title>{spec.title}</title>
        <line x1={pad} x2={W - pad} y1={H - pad} y2={H - pad} stroke="var(--line)" />
        <path d={linePath} fill="none" stroke="var(--orange)" stroke-width="3" />
        {pts.map((p) => <g><circle cx={p.x} cy={p.y} r="4.5" fill="var(--orange)" /><text class="bar-val" x={p.x} y={p.y - 10} text-anchor="middle">{fmt(p.v)}</text><text class="lbl" x={p.x} y={H - pad + 20} text-anchor="middle">{nf.format(Number(p.l)) === 'NaN' ? p.l : p.l.replace(/\d/g, (d) => '۰۱۲۳۴۵۶۷۸۹'[+d])}</text></g>)}
      </svg>
    )}
    {type === 'donut' && (
      <div class="donut">
        <svg viewBox="0 0 220 220" role="img" aria-labelledby={titleId} width="220" height="220">
          <title>{spec.title}</title>
          {arcs.map((a) => <path d={a.d} fill={a.c} stroke="#fff" stroke-width="2" />)}
        </svg>
        <ul class="legend">{arcs.map((a) => <li><span class="sw" style={`background:${a.c}`}></span>{a.r.label}: <strong>{fmt(Number(a.r.value))}</strong> <span class="muted small">({nf.format(Math.round((Number(a.r.value) / total) * 100))}٪)</span></li>)}</ul>
      </div>
    )}
    {type === 'timeline' && (
      <ol class="timeline">
        {rows.map((r) => <li><time datetime={dateParts(r.date).iso}>{dateFa(r.date)}</time><span>{r.label}</span></li>)}
      </ol>
    )}
    {type !== 'timeline' && (
      <details>
        <summary>جدول داده</summary>
        <div class="table-wrap"><table>
          <tbody>{rows.map((r) => <tr><th scope="row">{r.label ?? r.date}</th><td class="n">{r.value != null ? fmt(Number(r.value)) : ''}</td></tr>)}</tbody>
        </table></div>
      </details>
    )}
    {spec.source && <p class="src">منبع: {spec.source}</p>}
  </figure>
)}
<style>
  .post-chart { margin-block: 28px; }
  .donut { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; }
  .legend { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
  .sw { display: inline-block; inline-size: 12px; block-size: 12px; border-radius: 4px; margin-inline-end: 8px; vertical-align: middle; }
  .timeline { list-style: none; padding: 0; margin: 0; border-inline-start: 3px solid var(--orange-soft); }
  .timeline li { position: relative; padding-inline-start: 22px; padding-block: 8px; display: grid; gap: 2px; }
  .timeline li::before { content: ''; position: absolute; inset-inline-start: -8px; inset-block-start: 16px; inline-size: 13px; block-size: 13px; border-radius: 50%; background: var(--orange); border: 3px solid var(--surface); }
  .timeline time { font-weight: 700; color: var(--orange-ink); font-size: 0.92rem; }
</style>
