---
import Base from '../../layouts/Base.astro';
import Icon from '../Icon.astro';
import Faq from '../Faq.astro';
import Steps from './Steps.astro';
import CityBento from '../home/CityBento.astro';
import { APP_HOME, HOME_BOT, tme, CITIES, VIDEOS, type Lang } from '../../lib/site';
import { webPage, faqPage, ORG_ID } from '../../lib/seo';
import { abs } from '../../lib/site';
import { FAQ_FA, FAQ_EN } from '../../data/faq';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const path = fa ? '/fa/khane/' : '/en/rentals/';
const title = fa ? 'چمدونِ خانه: همهٔ آگهی‌های اجارهٔ خانهٔ ایرانی‌ها، یک‌جا' : 'Chamedoon Home: every Persian rental listing in one place';
const description = fa
  ? 'آگهی‌های اجارهٔ اتاق و آپارتمان از گروه‌ها و کانال‌های ایرانیِ تورنتو، مونترال، ونکوور، برلین، هامبورگ و کلن در یک مینی‌اپ تلگرام، با فیلتر و نقشه. رایگان.'
  : 'Rental listings from Iranian groups in Toronto, Montreal, Vancouver, Berlin, Hamburg and Cologne in one Telegram Mini App, with filters and a map. Free.';
const steps = fa
  ? [
      { icon: 'bot', t: 'ربات را باز کنید', d: 'در تلگرام @chamedoon_home_bot را باز کنید و شهرتان را انتخاب کنید.' },
      { icon: 'filter', t: 'دقیقش کنید', d: 'با فیلتر قیمت، محله، نوع خانه و مدت اجاره نتیجه را محدود کنید، یا آگهی‌ها را روی نقشه ببینید.' },
      { icon: 'bell', t: 'گوش‌به‌زنگ بسازید', d: 'آگهی تازه‌ای که به شرایطتان بخورد، در تلگرام خبرتان می‌کنیم.' },
    ]
  : [
      { icon: 'bot', t: 'Open the bot', d: 'Open @chamedoon_home_bot in Telegram and pick your city.' },
      { icon: 'filter', t: 'Narrow it down', d: 'Filter by price, area, home type and lease length, or browse the map.' },
      { icon: 'bell', t: 'Set an alert', d: 'When a new listing matches, we message you on Telegram.' },
    ];
const owner = fa
  ? [
      { icon: 'home', t: 'مشخصات و عکس', d: 'در ربات مشخصات و عکس‌های خانه را وارد کنید؛ آگهی‌تان مرتب و آماده می‌شود.' },
      { icon: 'users', t: 'به دست آدم درست', d: 'بقیه با فیلتر شهر، قیمت و نوع خانه پیدایش می‌کنند و گوش‌به‌زنگ‌ها خبردار می‌شوند.' },
      { icon: 'telegram', t: 'هر جا خواستید بفرستید', d: 'با «ارسال در تلگرام» یا لینک آگهی، آن را در هر گروهی بگذارید.' },
    ]
  : [
      { icon: 'home', t: 'Details and photos', d: 'Enter the details and photos in the bot; your listing comes out tidy and ready.' },
      { icon: 'users', t: 'Reach the right people', d: 'Seekers find it through city, price and type filters, and matching alerts fire.' },
      { icon: 'telegram', t: 'Share anywhere', d: 'Use “Send in Telegram” or the listing link to post it in any group.' },
    ];
const faq = (fa ? FAQ_FA : FAQ_EN).filter((f) => !/باربری|courier/i.test(f.q));
const service = {
  '@type': 'Service',
  '@id': abs(path) + '#service',
  name: fa ? 'چمدونِ خانه' : 'Chamedoon Home',
  serviceType: 'Rental listings aggregator',
  provider: { '@id': ORG_ID },
  areaServed: CITIES.map((c) => ({ '@type': 'City', name: c.en })),
  availableChannel: { '@type': 'ServiceChannel', serviceUrl: tme(HOME_BOT) },
  offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
  inLanguage: 'fa',
};
const crumbs = [{ name: fa ? 'چمدون' : 'Chamedoon', path: `/${lang}/` }, { name: fa ? 'چمدونِ خانه' : 'Chamedoon Home', path }];
const v = VIDEOS[0];
---
<Base lang={lang} title={title} description={description} path={path} alternates={{ fa: '/fa/khane/', en: '/en/rentals/' }} crumbs={crumbs} jsonld={[webPage(path, title, description, lang), service, faqPage(faq, lang)]}>
  <section class="page-hero">
    <div class="wrap grid-2" style="align-items:center">
      <div>
        <span class="eyebrow"><Icon name="home" size={18} />{fa ? 'چمدونِ خانه' : 'Chamedoon Home'}</span>
        <h1>{fa ? 'همهٔ آگهی‌های خانه، یک‌جا' : 'Every home listing, in one place'}</h1>
        <div class="answer" style="margin-block-end:22px"><p>{fa
          ? 'برای ایرانی‌هایی که در کانادا و آلمان خانه، اتاق یا هم‌خانه می‌خواهند: آگهی‌های گروه‌ها و کانال‌های فارسی‌زبانِ شش شهر، مرتب، بی‌اسپم و رایگان.'
          : 'For Iranians looking for a home, a room or a roommate in Canada and Germany: listings from Persian-language groups and channels in six cities, tidy, spam-free and free.'}</p></div>
        <div class="btn-row">
          <a class="btn btn-primary" href={APP_HOME} rel="nofollow"><Icon name="home" />{fa ? 'آگهی‌ها را ببینید' : 'Browse listings'}</a>
          <a class="btn btn-ghost" href={tme(HOME_BOT)} rel="noopener"><Icon name="telegram" /><span class="ltr">@{HOME_BOT}</span></a>
        </div>
      </div>
      <a class="vid card-link" href={`/fa/videos/${v.slug}/`}>
        <img src={v.poster} width="540" height="960" alt={v.title_fa} loading="eager" decoding="async" />
        <span class="play"><Icon name="play" size={30} /></span>
      </a>
    </div>
  </section>
  <section class="section-tight"><div class="wrap"><h2>{fa ? 'خانه پیدا کنید' : 'Find a home'}</h2><Steps steps={steps} /></div></section>
  <CityBento lang={lang} />
  <section class="section-tight"><div class="wrap"><h2>{fa ? 'خانه دارید؟ آگهی بدهید' : 'Have a place? Post it'}</h2><Steps steps={owner} /></div></section>
  <section class="section-tight"><div class="wrap prose"><Faq items={faq} title={fa ? 'پرسش‌های رایج' : 'Common questions'} /></div></section>
</Base>
<style>
  .vid { position: relative; max-inline-size: 300px; margin-inline: auto; border-radius: 28px; overflow: hidden; box-shadow: var(--shadow-lift); aspect-ratio: 9 / 16; background: var(--navy); }
  .vid img { inline-size: 100%; block-size: 100%; object-fit: cover; display: block; }
  .play { position: absolute; inset: 0; margin: auto; inline-size: 72px; block-size: 72px; border-radius: 50%; background: rgb(255 255 255 / 92%); color: var(--orange); display: grid; place-items: center; box-shadow: var(--shadow); }
</style>
