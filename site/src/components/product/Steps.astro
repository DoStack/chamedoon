---
import Icon from '../Icon.astro';
// Title + icon only (owner: the UI speaks; no explainer lines). `d` stays in the data for the page's structured data.
interface Props { steps: { icon: string; t: string; d?: string }[]; tone?: 'orange' | 'navy' }
const { steps, tone = 'orange' } = Astro.props;
---
<ol class:list={['steps', tone]}>
  {steps.map((s, i) => (
    <li class="reveal">
      <span class="ic"><Icon name={s.icon} size={26} /></span>
      <h3>{s.t}</h3>
    </li>
  ))}
</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); counter-reset: s; }
  .steps li { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 24px; box-shadow: var(--shadow); counter-increment: s; position: relative; }
  .steps li::after { content: counter(s, persian); position: absolute; inset-block-start: 18px; inset-inline-end: 22px; font-family: var(--font-display); font-weight: 900; font-size: 2.2rem; color: var(--muted); }
  :global(html[lang='en']) .steps li::after { content: counter(s); }
  .ic { inline-size: 60px; block-size: 60px; border-radius: 18px; display: grid; place-items: center; background: var(--accent); color: var(--orange); margin-block-end: 14px; transition: transform 0.3s cubic-bezier(.3,1.6,.5,1); }
  .steps li { transition: transform 0.2s, box-shadow 0.2s; }
  .steps li:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .steps li:hover .ic { transform: rotate(-10deg) scale(1.1); }
  @media (prefers-reduced-motion: no-preference) { @supports (animation-timeline: view()) { .ic { animation: pop linear both; animation-timeline: view(); animation-range: entry 0% entry 80%; } } }
  @keyframes pop { from { transform: scale(0.4) rotate(-20deg); opacity: 0; } to { transform: none; opacity: 1; } }
  .navy .ic { background: var(--navy-soft); color: var(--navy); }
  h3 { margin: 0; font-size: var(--step-1); }
</style>
