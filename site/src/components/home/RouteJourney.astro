---
// Suitcase journey: the route draws as the section scrolls (CSS scroll-driven), suitcase rides the path.
import { type Lang } from '../../lib/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
const stops = fa
  ? [
      { k: 'THR', t: 'مسافر پیدا کنید', d: 'سفر یا بسته‌تان را ثبت کنید؛ کسانی که همین مسیر را دارند پیدا می‌شوند.' },
      { k: 'IKA', t: 'تحویل بدهید', d: 'چمدون شما را به هم معرفی می‌کند؛ با هم هماهنگ می‌کنید و بسته را تحویل می‌دهید.' },
      { k: 'YYZ', t: 'تحویل بگیرید', d: 'بسته با مسافر می‌رسد و در مقصد تحویل گرفته می‌شود.' },
    ]
  : [
      { k: 'THR', t: 'Find a traveller', d: 'Post your trip or your package; people on the same route show up.' },
      { k: 'IKA', t: 'Hand it over', d: 'Chamedoon introduces you; you arrange the hand-over together.' },
      { k: 'YYZ', t: 'Pick it up', d: 'The package travels with the passenger and is collected at the destination.' },
    ];
// Path drawn left→right in SVG space; for RTL the SVG is mirrored so Tehran sits on the right (reading start).
const PATH = 'M60 210 C 200 60, 330 60, 420 140 S 640 250, 760 120 S 900 40, 940 90';
---
<section class="section journey" aria-labelledby="journey-h">
  <div class="wrap">
    <h2 id="journey-h" class="reveal">{fa ? 'سفر یک چمدان، در سه قدم' : 'A suitcase’s trip in three steps'}</h2>
    <div class="track">
      <svg viewBox="0 0 1000 280" aria-hidden="true" class:list={['route', { mirror: fa }]}>
        <path d={PATH} class="ghost" />
        <path d={PATH} class="draw" pathLength="1" />
        <g class="rider">
          <rect x="-16" y="-14" width="32" height="26" rx="6" fill="var(--orange)" />
          <path d="M-6 -14v-5a3 3 0 0 1 3-3h6a3 3 0 0 1 3 3v5" stroke="var(--navy)" stroke-width="3" fill="none" />
          <circle cx="-9" cy="15" r="3" fill="var(--navy)" /><circle cx="9" cy="15" r="3" fill="var(--navy)" />
        </g>
        <circle cx="60" cy="210" r="9" class="stop" />
        <circle cx="420" cy="140" r="9" class="stop" />
        <circle cx="940" cy="90" r="9" class="stop" />
      </svg>
      <ol class="stops">
        {stops.map((s, i) => (
          <li class="reveal" style={`--i:${i}`}>
            <span class="code ltr">{s.k}</span>
            <h3>{s.t}</h3>
            <p class="muted">{s.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
<style>
  .journey { overflow: clip; }
  .track { position: relative; }
  .route { inline-size: 100%; block-size: auto; display: block; margin-block: 8px 24px; }
  .route.mirror { transform: scaleX(-1); }
  .ghost { fill: none; stroke: var(--line); stroke-width: 4; stroke-dasharray: 2 12; stroke-linecap: round; }
  .draw { fill: none; stroke: var(--navy); stroke-width: 4; stroke-linecap: round; }
  .stop { fill: var(--surface); stroke: var(--orange); stroke-width: 4; }
  .rider { offset-path: path('M60 210 C 200 60, 330 60, 420 140 S 640 250, 760 120 S 900 40, 940 90'); offset-distance: 100%; offset-rotate: 0deg; }
  .route.mirror .rider { transform: scaleX(-1); }
  .stops { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  @media (max-width: 760px) { .stops { grid-template-columns: 1fr; } }
  .code { display: inline-block; font-weight: 800; letter-spacing: 0.08em; color: var(--navy-ink); background: var(--navy-soft); padding: 2px 10px; border-radius: 8px; margin-block-end: 8px; font-size: 0.85rem; }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .draw { stroke-dasharray: 1; animation: drawpath linear both; animation-timeline: view(); animation-range: entry 20% cover 60%; }
      .rider { animation: ride linear both; animation-timeline: view(); animation-range: entry 20% cover 60%; }
    }
  }
  @keyframes drawpath { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ride { from { offset-distance: 0%; } to { offset-distance: 100%; } }
</style>
