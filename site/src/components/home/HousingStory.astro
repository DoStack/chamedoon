---
import Icon from '../Icon.astro';
import { CITIES, type Lang } from '../../lib/site';
import { latest } from '../../lib/stats';
import { money, typeLabel, dateShortFa, dateParts } from '../../lib/format';
interface Props { lang: Lang }
const { lang } = Astro.props;
const fa = lang === 'fa';
// Real, recent listings from the public feed (type, area, price, date only).
const cards = CITIES.flatMap((c) => latest(c.slug).slice(0, 1).map((l) => ({ ...l, city: c }))).slice(0, 5);
const steps = fa
  ? [
      { icon: 'megaphone', t: 'همهٔ آگهی‌های گروه‌ها و کانال‌های ایرانی، یک‌جا' },
      { icon: 'filter', t: 'شهر، قیمت، محله و نوع خونه را فیلتر کنید' },
      { icon: 'bell', t: 'گوش‌به‌زنگ بسازید؛ آگهی مناسب که بیاید، خبرتان می‌کنیم' },
    ]
  : [
      { icon: 'megaphone', t: 'Every listing from Iranian groups and channels, in one place' },
      { icon: 'filter', t: 'Filter by city, price, area and home type' },
      { icon: 'bell', t: 'Set an alert; we tell you when a matching home appears' },
    ];
---
<section class="section story" aria-labelledby="story-h">
  <div class="wrap story-grid">
    <div class="steps">
      <span class="eyebrow"><Icon name="home" size={18} />{fa ? 'چمدونِ خانه' : 'Chamedoon Home'}</span>
      <h2 id="story-h">{fa ? 'خونه پیدا کردن، بدون اسکرول بی‌پایان' : 'Finding a home without endless scrolling'}</h2>
      <ol>
        {steps.map((s, i) => (
          <li class="step reveal"><span class="n num">{fa ? '۱۲۳'[i] : i + 1}</span><span>{s.t}</span></li>
        ))}
      </ol>
      <a class="btn btn-primary" href={fa ? '/fa/khane/' : '/en/rentals/'}>{fa ? 'دربارهٔ چمدونِ خانه' : 'About Chamedoon Home'}<Icon name="arrow" size={18} /></a>
    </div>
    <div class="stack-wrap" aria-label={fa ? 'نمونهٔ آگهی‌های تازه' : 'Recent listings'} role="list">
      {cards.map((l, i) => (
        <div class="lcard" role="listitem" style={`--i:${i}`}>
          <div class="lrow">
            <span class="chip chip-orange">{typeLabel(l.type, lang)}</span>
            <span class="small muted">{fa ? l.city.fa : l.city.en}</span>
          </div>
          <p class="area">{(fa ? l.area_fa : l.area_en) || (fa ? l.city.fa : l.city.en)}</p>
          <div class="lrow">
            <strong class="price num">{money(l.price, l.currency, lang)}</strong>
            <time class="small muted" datetime={dateParts(l.first_seen).iso}>{fa ? dateShortFa(l.first_seen) : dateParts(l.first_seen).en}</time>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
<style>
  .story { background: linear-gradient(180deg, var(--bg), var(--warm) 40%, var(--bg)); }
  .story-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: start; }
  @media (max-width: 860px) { .story-grid { grid-template-columns: 1fr; } }
  .steps { position: sticky; inset-block-start: 100px; }
  ol { list-style: none; padding: 0; margin: 0 0 28px; display: grid; gap: 18px; }
  .step { display: flex; gap: 16px; align-items: center; font-size: var(--step-1); font-weight: 700; }
  .step .n { flex: none; inline-size: 48px; block-size: 48px; border-radius: 16px; display: grid; place-items: center; background: var(--orange); color: #fff; font-family: var(--font-display); font-size: 1.3rem; }
  .stack-wrap { display: grid; gap: 14px; padding-block: 10px; }
  .lcard { background: var(--surface); border: 1px solid var(--line); border-radius: 20px; padding: 18px 20px; box-shadow: var(--shadow); }
  .lrow { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
  .area { margin: 10px 0; font-weight: 700; font-size: 1.05rem; }
  .price { font-size: 1.2rem; color: var(--orange-ink); }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .lcard { animation: fan linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
      .lcard:nth-child(odd) { --rot: -3deg; }
      .lcard:nth-child(even) { --rot: 3deg; }
    }
  }
  @keyframes fan { from { opacity: 0; transform: translateY(60px) rotate(var(--rot, 0deg)) scale(0.94); } to { opacity: 1; transform: none; } }
</style>
