const flip = name === 'arrow';
---
<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class:list={[cls, { flip }]} set:html={P[name] || ''} />
<style>
