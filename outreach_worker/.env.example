# Telegram app keys from https://my.telegram.org -> API development tools (shared by the accounts)
TG_API_ID=
TG_API_HASH=

# The sending accounts, and one session each. Full access to the account: never share or commit.
OUTREACH_ACCOUNTS=sina,sara,monis
SINA_TG_SESSION=
SARA_TG_SESSION=
MONIS_TG_SESSION=
# An account with its own app keys: SARA_TG_API_ID=, SARA_TG_API_HASH=

# The Vercel app, and the same value as OUTREACH_SERVICE_SECRET on Vercel
API_BASE_URL=https://your-app.vercel.app
OUTREACH_SERVICE_SECRET=
