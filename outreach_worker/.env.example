# Telegram app keys from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=

# Written by `python login.py`. Full access to the account: never share or commit it.
TG_SESSION=

# Your Vercel app, and the same value as OUTREACH_SERVICE_SECRET on Vercel
API_BASE_URL=https://your-app.vercel.app
OUTREACH_SERVICE_SECRET=

# Random pause between two sends, in seconds
MIN_DELAY_SECONDS=150
MAX_DELAY_SECONDS=330
