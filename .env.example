# Django
SECRET_KEY=change-me-in-development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
DATABASE_URL=postgres://chamedoon:chamedoon@postgres:5432/chamedoon
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000

# Telegram (used from Phase 2 / Phase 5)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=<your_bot_username>
TELEGRAM_WEBHOOK_SECRET=
BOT_SERVICE_SECRET=change-me-bot-secret

# Production (leave unset locally)
# TRUST_PROXY=true
# TELEGRAM_MINI_APP_URL=https://your-app.vercel.app

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=<your_bot_username>

# Bot (Docker uses API_BASE_URL=http://backend:8000)
API_BASE_URL=http://localhost:8000
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_SHORT_NAME=app

# Official marketplace channel (bot must be a channel admin with post permission)
TELEGRAM_CHANNEL_ID=-100...
TELEGRAM_CHANNEL_USERNAME=chamed0on
TELEGRAM_CHANNEL_URL=https://t.me/chamed0on
TELEGRAM_GROUP_USERNAME=
TELEGRAM_CHANNEL_ENABLED=true

# Public competitor/community channel ingest (one daily Vercel cron)
CRON_SECRET=change-me-cron-secret
MARKET_CHANNEL_USERNAME=koolbar_international
MARKET_CHANNEL_USERNAMES=koolbar_international,koolbarcanada,CoolbarEUIRAN,CoolbarUKIRAN,bahsazadkolbar,HamrahbarUSA
# key:invite_hash pairs. Empty disables invite crawling.
MARKET_SOURCE_INVITES=koolbarcanada-group:mRng6VpbVNwzMDNh,hamrahbar-usa-group:BNQ_Nhj3fqmv8A0-Ol62lg,koolbar-qa:DRN0lwXOnNxiNGRh
# Member account used only to read listing groups. Leave empty to fall back to OUTREACH_TG_*.
MARKET_TG_API_ID=
MARKET_TG_API_HASH=
MARKET_TG_SESSION=
MARKET_INGEST_ENABLED=true
MARKET_INGEST_TELEGRAM_USER_ID=1

# Convert crawled posts with OpenAI. OpenRouter is optional.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Max LLM reviews per daily cron / manual extract (Vercel 60s)
MARKET_LLM_REVIEW_LIMIT=12

# Persian DMs from the Chamedoon Telegram account to imported demanders (docs/outreach.md)
OUTREACH_ENABLED=false
OUTREACH_SENDING_ENABLED=false
OUTREACH_SERVICE_SECRET=change-me-outreach-secret
OUTREACH_DAILY_LIMIT=10
OUTREACH_MIN_SCORE=80
# The Telegram account for sending from Vercel crons (session from `outreach_worker/login.py --server`)
OUTREACH_TG_API_ID=
OUTREACH_TG_API_HASH=
OUTREACH_TG_SESSION=

# Chamedoon Home (housing board), see docs/home.md
HOME_ENABLED=true
# Token of the housing bot (@chamedoon_home_bot). Home settings in the admin win. NOT TELEGRAM_BOT_TOKEN (that is the courier bot).
HOME_BOT_TOKEN=
# Private group invites for the housing reader, key:hash pairs (the repo is public: never commit the hash)
HOME_SOURCE_INVITES=
# Photo storage. Empty = photos are not downloaded. r2 = Cloudflare R2 (S3 API, free 10 GB, no egress fee)
HOME_MEDIA_BACKEND=
HOME_MEDIA_BUCKET=
HOME_MEDIA_PUBLIC_BASE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional second AI pass that reads the photos. Needs an image-capable model id.
HOME_VISION_ENABLED=false
HOME_VISION_MODEL=
