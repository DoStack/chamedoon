# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=CB_koolbarbot

# Bot (Docker uses API_BASE_URL=http://backend:8000)
API_BASE_URL=http://localhost:8000
TELEGRAM_MINI_APP_URL=
TELEGRAM_MINI_APP_SHORT_NAME=app

# Official marketplace channel (bot must be a channel admin with post permission)
TELEGRAM_CHANNEL_ID=-100...
TELEGRAM_CHANNEL_USERNAME=
TELEGRAM_CHANNEL_URL=https://t.me/+26pUh8_5u0w1MTVk
TELEGRAM_GROUP_USERNAME=
TELEGRAM_CHANNEL_ENABLED=true

# Public competitor/community channel ingest (daily Vercel cron)
CRON_SECRET=change-me-cron-secret
MARKET_CHANNEL_USERNAME=koolbar_international
MARKET_CHANNEL_USERNAMES=koolbar_international,koolbarcanada,CoolbarEUIRAN,CoolbarUKIRAN,bahsazadkolbar,HamrahbarUSA
MARKET_INGEST_ENABLED=true
MARKET_INGEST_TELEGRAM_USER_ID=1

# OpenRouter free models, then paid ChatGPT if they all fail
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Max LLM reviews per cron run (Vercel 60s + free-model rate limits)
MARKET_LLM_REVIEW_LIMIT=12
# Wait this many hours after LLM failure before creating the request from regex rules
MARKET_LLM_RETRY_HOURS=6
