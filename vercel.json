{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "functions": {
    "backend/config/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/market-channel/",
      "schedule": "0 */4 * * *"
    },
    {
      "path": "/api/cron/market-migrate/",
      "schedule": "0 6 * * *"
    }
  ]
}
