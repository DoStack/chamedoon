{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "functions": {
    "backend/config/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/market-extract/",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/market-convert/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/market-publish/",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/outreach-build/",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/outreach-send/",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/outreach-send-2/",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/cron/outreach-send-3/",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/cron/outreach-send-4/",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/home/",
      "schedule": "5 3 * * *"
    },
    {
      "path": "/api/cron/home-2/",
      "schedule": "5 8 * * *"
    },
    {
      "path": "/api/cron/home-3/",
      "schedule": "5 11 * * *"
    },
    {
      "path": "/api/cron/home-4/",
      "schedule": "5 14 * * *"
    },
    {
      "path": "/api/cron/home-5/",
      "schedule": "5 18 * * *"
    },
    {
      "path": "/api/cron/home-6/",
      "schedule": "5 21 * * *"
    }
  ]
}
