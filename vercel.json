{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "django",
  "functions": {
    "backend/config/wsgi.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/market-extract/",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/market-convert/",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/market-publish/",
      "schedule": "0 4 * * *"
    }
  ]
}
